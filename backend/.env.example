# =================================================================
# Sea Sentinel 2.0 — Backend Environment Variables Configuration
# =================================================================

SEA_SENTINEL_ENV=development
SEA_SENTINEL_DEBUG=True
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

JWT_SECRET_KEY=sea_sentinel_super_secret_dev_key_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

DEVICE=auto
TORCH_NUM_THREADS=4
FP16_ENABLED=True

YOLO_MODEL_PATH=models/yolo11n.pt
UNET_MODEL_PATH=models/checkpoints/unet/attention_unet_best.pth
AUTOENCODER_MODEL_PATH=models/checkpoints/autoencoder/autoencoder_best.pth

DATA_DIR=data
DATASETS_DIR=datasets
OUTPUT_DIR=outputs
AUDIT_DB_PATH=outputs/audit/survey_audit.db
GIS_DB_PATH=outputs/database/local_gis.db

DEFAULT_CRS=EPSG:4326
SURVEY_ORIGIN_LAT=15.1234
SURVEY_ORIGIN_LON=73.5678

# AI Inference Runtime (Options: pytorch, onnx)
AI_RUNTIME=pytorch
